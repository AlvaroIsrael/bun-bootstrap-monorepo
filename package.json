{
  "name": "bun-app",
  "private": true,
  "description": "🥠 A simple TypeScript monorepo boostrap for bun.",
  "license": "Apache-2.0",
  "author": "Alvaro Israel Nunes Leite",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "format": "bunx oxfmt apps/",
    "lint": "bunx oxlint apps/",
    "libraryUpdate": "bun update --interactive"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "packageManager": "bun@1.4.2"
}