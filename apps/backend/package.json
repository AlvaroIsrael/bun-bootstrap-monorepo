{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "description": "A simple backend boostrap for bun with Nest and MikroORM.",
  "license": "Apache-2.0",
  "author": "Alvaro Israel Nunes Leite",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "start": "nest start",
    "start:dev": "bun run nest start -b swc --watch",
    "start:debug": "bun run nest start -b swc --debug --watch",
    "start:prod": "node dist/server",
    "libraryUpdate": "bun update --interactive"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.0",
    "@mikro-orm/decorators": "^7.2.0",
    "@mikro-orm/entity-generator": "^7.2.0",
    "@mikro-orm/migrations": "^7.2.0",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.0",
    "@mikro-orm/seeder": "^7.2.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.3",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.5.1",
    "bun-types": "^1.4.2",
    "chokidar": "^5.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.4.2"
}
